                      "fontSize": "10pt",
                      "color": "#33415C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Bikes bring 95% of revenue; accessories are 69% of units sold.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#33415C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 The US and Australia bring 62% of revenue.",
