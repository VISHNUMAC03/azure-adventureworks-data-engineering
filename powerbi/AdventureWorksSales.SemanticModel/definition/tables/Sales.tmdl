table Sales
	lineageTag: a6df71ad-42b8-4d2f-a606-77516bc94ce8

	measure 'Total Revenue' = SUM(Sales[Revenue])
		formatString: \$#,0
		lineageTag: 56a289d0-182e-435a-b121-bfb061f14bf9

	measure 'Revenue ($K)' = DIVIDE([Total Revenue], 1000)
		formatString: \$#,0.0\K
		lineageTag: c819d1a4-fc46-4516-a61a-0014b1ffcde6

	measure 'Total Cost' = SUM(Sales[Cost])
		formatString: \$#,0
		lineageTag: 237a6838-88db-4da6-9887-14b6415ba236

	measure 'Total Profit' = SUM(Sales[Profit])
		formatString: \$#,0
		lineageTag: 816eef2b-9f89-446d-8118-4a615617f86c

	measure 'Profit Margin' = DIVIDE([Total Profit], [Total Revenue])
		formatString: 0.0%
		lineageTag: 7f7d0f5c-2c5e-4edc-a137-55fabd5f0409

	measure 'Total Orders' = DISTINCTCOUNT(Sales[OrderNumber])
		formatString: #,0
		lineageTag: 721d58d4-3173-44eb-840a-538ab4601125

	measure 'Quantity Sold' = SUM(Sales[OrderQuantity])
		formatString: #,0
		lineageTag: aa218f8f-4b28-491c-adca-a4c143f8d651

	measure 'Customers' = DISTINCTCOUNT(Sales[CustomerKey])
		formatString: #,0
		lineageTag: 4f698d04-9084-4813-93e9-a16f32f499a8

	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: \$#,0.00
		lineageTag: 1b3df156-9a5c-43a4-9204-db07abf5bdb2

	measure 'Revenue per Customer' = DIVIDE([Total Revenue], [Customers])
		formatString: \$#,0.00
		lineageTag: 0368137a-b361-47a9-a1c2-1690f585fd73

	column OrderDate
		dataType: dateTime
		formatString: Short Date
		lineageTag: daecaec0-cca5-4560-b596-7d9daffc7459
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = Automatic

