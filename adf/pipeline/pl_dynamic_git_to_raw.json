{
    "name": "pl_dynamic_git_to_raw",
    "properties": {
        "description": "Config-driven ingestion: one Copy activity loads every table listed in git.json from GitHub into the raw container.",
        "activities": [
            {
                "name": "LookupGit",
                "description": "Read every entry of the control file (First row only = false).",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "source": {
                        "type": "JsonSource",
                        "storeSettings": {
                            "type": "AzureBlobFSReadSettings",
                            "recursive": true,
                            "enablePartitionDiscovery": false
                        },
                        "formatSettings": { "type": "JsonReadSettings" }
                    },
                    "dataset": {
                        "referenceName": "ds_adls_git_json",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "ForEachGit",
                "description": "Loop over the tables returned by the lookup and copy each one in parallel.",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "LookupGit",
                        "dependencyConditions": [ "Succeeded" ]
                    }
                ],
                "typeProperties": {
                    "items": {
                        "value": "@activity('LookupGit').output.value",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "activities": [
                        {
                            "name": "CopyRawData",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 1,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "typeProperties": {
                                "source": {
                                    "type": "DelimitedTextSource",
                                    "storeSettings": {
                                        "type": "HttpReadSettings",
                                        "requestMethod": "GET"
                                    },
                                    "formatSettings": { "type": "DelimitedTextReadSettings" }
                                },
                                "sink": {
                                    "type": "DelimitedTextSink",
                                    "storeSettings": { "type": "AzureBlobFSWriteSettings" },
                                    "formatSettings": {
                                        "type": "DelimitedTextWriteSettings",
                                        "quoteAllText": true,
                                        "fileExtension": ".csv"
                                    }
                                },
                                "enableStaging": false
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_http_csv",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_rel_url": {
                                            "value": "@item().p_rel_url",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_adls_raw_csv",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "p_sink_folder": {
                                            "value": "@item().p_Sink_Folder",
                                            "type": "Expression"
                                        },
                                        "p_sink_file": {
                                            "value": "@item().p_Sink_File",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            }
        ],
        "annotations": []
    }
}
