{
    "name": "ds_adls_raw_csv",
    "properties": {
        "description": "Landing location in the raw (bronze) container. Folder and file name come from git.json.",
        "linkedServiceName": {
            "referenceName": "ls_adls_awvmac03",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "p_sink_folder": { "type": "string" },
            "p_sink_file": { "type": "string" }
        },
        "annotations": [],
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileName": {
                    "value": "@dataset().p_sink_file",
                    "type": "Expression"
                },
                "folderPath": {
                    "value": "@dataset().p_sink_folder",
                    "type": "Expression"
                },
                "fileSystem": "raw"
            },
            "columnDelimiter": ",",
            "escapeChar": "\\",
            "firstRowAsHeader": true,
            "quoteChar": "\""
        },
        "schema": []
    }
}
